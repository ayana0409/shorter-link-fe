REACT_APP_CLIENT_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:3001
REACT_APP_WS_URL=http://localhost:3002

# Token refresh settings
REACT_APP_REFRESH_THRESHOLD_MS=360000    # 6 min (ms)
REACT_APP_PROACTIVE_REFRESH_INTERVAL_MS=120000  # 2 min (ms)

# QuickBite SSO Identity Server Configuration
REACT_APP_IDENTITY_SERVICE_URL=https://example.com
REACT_APP_OIDC_CLIENT_ID=example
REACT_APP_OIDC_SCOPE=example_scope
REACT_APP_GOOGLE_CLIENT_ID=example


# System Maintenance & Operating Hours (UTC+7)
# Enable maintenance mode (blocks all requests and web sockets, shows maintenance screen)
REACT_APP_IS_MAINTAIN=false
# Daily operating window (in 24h format HH:mm, UTC+7)
REACT_APP_STARTUP=08:00
REACT_APP_SHUTDOWN=22:00
# Minutes before shutdown to start showing reminder toast every 30s
REACT_APP_NEAR_SHUTDOWN_WARNING_MINUTES=15
